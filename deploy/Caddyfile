# JellyJet 2 web app. Cloudflare's tunnel provides HTTPS in front of this, so
# Caddy only listens on plain http inside the machine.
#
#   /pipeline/…      → the download orchestrator (it checks its own API key)
#   /web…            → blocked: Jellyfin's own website isn't offered here
#   JellyJet's files → served from the site folder
#   anything else    → Jellyfin (sign-in, library, artwork, audio streams)
{
	admin off
	auto_https off
	servers {
		# Keep the visitor's real address from the tunnel, so Jellyfin sees
		# who is connecting rather than this container.
		trusted_proxies static private_ranges
	}
}

{$LISTEN::8080} {
	encode zstd gzip

	handle_path /pipeline/* {
		reverse_proxy {$PIPELINE_UPSTREAM:host.docker.internal:8420}
	}

	handle /web* {
		respond 404
	}

	@app file {
		root {$SITE_ROOT:/srv}
		try_files {path} {path}index.html
	}
	handle @app {
		root * {$SITE_ROOT:/srv}
		header X-Content-Type-Options nosniff
		# Build files carry a content hash in their name, so they never change.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# The page and service worker must always be checked, or a new release
		# won't load.
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy {$JELLYFIN_UPSTREAM:host.docker.internal:8096}
	}
}
